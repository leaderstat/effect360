# Files that should never end up inside Docker build contexts.
# Compose использует build context = . для сервисов, где указан context: .
# в compose.yaml (например, database/). Этот файл защищает от случайного
# копирования секретов и тяжёлых артефактов в образ.
# Generated Gleam/Lustre build artifacts
services/frontend/build/

# Secrets and env
.env
.env.*
!.env.example

# Git
.git
.gitignore
.gitattributes

# Compose project metadata
.compose-project

# Build artifacts
services/api/build/
services/worker/worker
services/worker/coverage.out

# Editor / OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docs (не нужны внутри контейнеров)
docs/

# Logs
*.log
logs/
