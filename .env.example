POSTGRES_DB=effectivnost360
POSTGRES_USER=effectivnost360
POSTGRES_PASSWORD=local-dev-only-change-me
DATABASE_URL=postgres://effectivnost360:local-dev-only-change-me@postgres:5432/effectivnost360
NATS_URL=nats://nats:4222
NATS_STREAM=EFFECTIVNOST_JOBS
NATS_SUBJECT=requests.*
PORT=8000
SECRET_KEY_BASE=local-dev-only-replace-with-at-least-64-random-characters-before-deployment

# --- Consumer (Local LLM classifier) ---
# The consumer can call any OpenAI-compatible local LLM. Default
# provider: Ollama. Leave LOCAL_LLM_BASE_URL empty to use the
# deterministic heuristic classifier (safe degradation).
#
# Ollama (most common local setup):
#   1. Install Ollama on the host: https://ollama.com/download
#   2. Pull a model (NOT done automatically; review docs first):
#      ollama pull devstral-small-2:latest
#   3. Start the server: ollama serve  (default: http://127.0.0.1:11434)
#   4. From inside the consumer container, use http://host.docker.internal:11434
#      (Docker Desktop: works out of the box; Linux: requires
#      --add-host=host.docker.internal:host-gateway on run).
#   5. Set LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
#
# OpenAI-compatible proxy (llama.cpp server, vLLM, LocalAI):
#   Set LOCAL_LLM_PROVIDER=openai-compatible and point BASE_URL at it.
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=devstral-small-2:latest
LOCAL_LLM_TIMEOUT=30s
LOCAL_LLM_TEMPERATURE=0.1
