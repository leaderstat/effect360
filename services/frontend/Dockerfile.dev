# services/frontend/Dockerfile.dev — fast Gleam/Lustre iteration image.
#
# Contains the toolchain and the downloaded Hex dependencies, but NOT the
# application sources. Mount `src/`, `test/` and `gleam.toml` over it and run
# `gleam build --target javascript` to type-check the Lustre application in
# seconds instead of a full Docker build.
#
#   docker run --rm -v ${PWD}/src:/app/src -v ${PWD}/test:/app/test fe-dev:dev
FROM erlang:28-alpine
ARG GLEAM_VERSION=1.19.2
RUN apk add --no-cache curl tar bash git nodejs npm \
  && curl -fsSL "https://github.com/gleam-lang/gleam/releases/download/v${GLEAM_VERSION}/gleam-v${GLEAM_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
  | tar -xz -C /usr/local/bin
WORKDIR /app
COPY gleam.toml ./
RUN gleam deps download
CMD ["gleam", "build", "--target", "javascript"]
